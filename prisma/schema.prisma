generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Fiche cliente de l'atelier : mesures de base (cm) conservées en base.
model Client {
  id        String   @id @default(cuid())
  name      String
  /// Poitrine (cm)
  P         Float
  /// Taille (cm)
  T         Float
  /// Hanches (cm)
  H         Float
  /// Longueur de référence (cm)
  L         Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
