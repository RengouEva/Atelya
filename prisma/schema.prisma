generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Fiche cliente de l'atelier : mesures de base (cm) conservées en base.
model Client {
  id        String   @id @default(cuid())
  name      String
  /// Poitrine (cm)
  P         Float
  /// Taille (cm)
  T         Float
  /// Hanches (cm)
  H         Float
  /// Longueur de référence (cm)
  L         Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Modèle de vêtement validé par l'encadrement : photo de référence,
/// catégorie, mesures de référence, pièces de patronage (ajoutées
/// manuellement), méthode d'assemblage pas à pas et accessoires
/// proposables dans la confection 3D. Les apprentis choisissent leur
/// modèle dans ce catalogue — la qualité est garantie par l'atelier.
model GarmentModel {
  id          String   @id @default(cuid())
  name        String
  /// Catégorie (robe | jupe | pantalon | tshirt | chemise | veste)
  category    String
  /// Photo de référence du vêtement (data URL ou chemin public) — facultative
  photo       String   @default("")
  /// Description courte affichée dans le catalogue
  description String?
  /// Mesures de référence du patronage — JSON {P,T,H,L,W,S,C}
  baseMeasures String
  /// Paramètres de rendu 3D — JSON {length, flare, sleeves, collar, fit, waistband...}
  shape       String   @default("{}")
  /// Pièces du patronage ajoutées manuellement — JSON [{n,w,h,q,fold,shape,note}]
  pieces      String   @default("[]")
  /// Méthode d'assemblage pas à pas — JSON [[consigne, pièce1, pièce2, jonction, détail]]
  assembly    String   @default("[]")
  /// Accessoires proposables dans la confection 3D — JSON ["bouton","fermeture",...]
  accessories String   @default("[]")
  /// Visible dans le catalogue des apprentis
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects StudioProject[]
}

/// Projet de l'apprenti : modèle choisi dans le catalogue atelier,
/// mesures de la cliente, coloris du tissu et accessoires retenus
/// dans la confection 3D.
model StudioProject {
  id          String       @id @default(cuid())
  name        String
  model       GarmentModel? @relation(fields: [modelId], references: [id])
  /// Modèle du catalogue atelier
  modelId     String?
  /// Mesures JSON {P,T,H,L,W,S,C}
  measures    String
  /// Accessoires choisis — JSON [{type,color}]
  accessories String       @default("[]")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
