generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Fiche cliente de l'atelier : mesures de base (cm) conservées en base.
model Client {
  id        String   @id @default(cuid())
  name      String
  /// Poitrine (cm)
  P         Float
  /// Taille (cm)
  T         Float
  /// Hanches (cm)
  H         Float
  /// Longueur de référence (cm)
  L         Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Visuel généré par IA (produit fini, texture de tissu, pièces en situation).
/// `sig` = empreinte déterministe des paramètres → sert de cache ; les
/// variations ajoutent un nonce au sig pour forcer une nouvelle image.
model AiVisual {
  id        String   @id @default(cuid())
  kind      String
  sig       String   @unique
  prompt    String
  mime      String   @default("image/png")
  data      String
  createdAt DateTime @default(now())
}

/// Projet du styliste-modéliste : photo d'origine, famille choisie,
/// mesures, les 3 variantes IA (empreintes des images en cache) et
/// la variante sélectionnée qui sert de base au patron.
model StudioProject {
  id        String   @id @default(cuid())
  name      String
  /// Photo d'origine (JPEG réduite, base64)
  photo     String
  /// Famille de vêtement (robe | jupe | pantalon | haut | veste)
  family    String
  /// Mesures JSON {P,T,H,L,W,S,C}
  measures  String
  /// Variantes IA JSON [{sig,label,desc,direction}]
  variants  String  @default("[]")
  /// Index de la variante retenue (-1 = aucune)
  selected  Int      @default(-1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
